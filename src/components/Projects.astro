---
import { projects } from '../data/projects.ts';
---
<section id="projetos" class="py-20 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto">
    <header class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-[var(--color-fg)] mb-4">Projetos em Destaque</h2>
      <p class="text-[var(--color-fg-muted)] max-w-2xl mx-auto">
        Projetos reais com foco em backend, dados e APIs. Cada card destaca a relevância para Engenharia de Dados.
      </p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2">
      {projects.filter(p => p.featured).map(project => (
        <article class="bg-[var(--color-card)] border border-[var(--color-border)] rounded-xl overflow-hidden hover:border-[var(--color-primary)]/50 hover:shadow-lg transition-all duration-300">
          <div class="p-6">
            <div class="flex items-start justify-between gap-4 mb-3">
              <h3 class="text-xl font-semibold text-[var(--color-fg)]">{project.title}</h3>
              <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-[var(--color-primary)] hover:underline flex items-center gap-1">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                Código
              </a>
            </div>
            <p class="text-[var(--color-fg-muted)] mb-4 leading-relaxed">{project.description}</p>

            {project.longDescription && (
              <p class="text-sm text-[var(--color-fg-muted)] mb-4 line-clamp-3">{project.longDescription}</p>
            )}

            {project.dataRelevance && (
              <div class="mb-4 p-3 bg-[var(--color-primary)]/5 border border-[var(--color-primary)]/20 rounded-lg">
                <p class="text-sm font-medium text-[var(--color-primary)] mb-1">🎯 Relevância para Data Engineering</p>
                <p class="text-sm text-[var(--color-fg-muted)]">{project.dataRelevance}</p>
              </div>
            )}

            <div class="flex flex-wrap gap-2" role="list" aria-label="Tecnologias utilizadas">
              {project.stack.map(tech => (
                <span class="px-2.5 py-1 text-xs font-medium bg-[var(--color-bg-muted)] text-[var(--color-fg-muted)] border border-[var(--color-border)] rounded" role="listitem">{tech}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="text-center mt-12">
      <a href="https://github.com/Luizddev" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-[var(--color-primary)] hover:underline font-medium">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
        Ver mais no GitHub
      </a>
    </div>
  </div>
</section>