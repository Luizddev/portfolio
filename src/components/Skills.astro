---
import { skillCategories, iconSVGs } from '../data/skills.ts';
---
<section id="habilidades" class="py-20 px-4 sm:px-6 lg:px-8 bg-[var(--color-bg-muted)]">
  <div class="max-w-6xl mx-auto">
    <header class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-[var(--color-fg)] mb-4">Habilidades Técnicas</h2>
      <p class="text-[var(--color-fg-muted)] max-w-2xl mx-auto">
        Foco em Engenharia de Dados e Backend. Níveis: <strong>Proficiente</strong> (uso diário), <strong>Em aprendizado</strong> (projetos ativos), <strong>Familiar</strong> (conceitos sólidos).
      </p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {skillCategories.map(category => (
        <article class="bg-[var(--color-card)] border border-[var(--color-border)] rounded-xl p-6 hover:border-[var(--color-primary)]/50 hover:shadow-lg transition-all duration-300">
          <div class="flex items-center gap-3 mb-4">
            <div class="p-2 rounded-lg bg-[var(--color-primary)]/10 text-[var(--color-primary)]" aria-hidden="true">
              {iconSVGs[category.icon]}
            </div>
            <h3 class="text-lg font-semibold text-[var(--color-fg)]">{category.name}</h3>
          </div>
          <ul class="space-y-2" role="list">
            {category.skills.map(skill => (
              <li class="flex items-center justify-between">
                <span class="text-[var(--color-fg)]">{skill.name}</span>
                {skill.level && (
                  <span class={`text-xs px-2 py-0.5 rounded-full ${
                    skill.level === 'proficient' ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400' :
                    skill.level === 'learning' ? 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400' :
                    'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-400'
                  }`}>
                    {skill.level === 'proficient' && 'Proficiente'}
                    {skill.level === 'learning' && 'Aprendendo'}
                    {skill.level === 'familiar' && 'Familiar'}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>